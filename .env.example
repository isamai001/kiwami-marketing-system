# Kiwami Marketing System - Environment Variables
# Copy this file to .env and fill in your real API tokens
# NEVER commit the .env file to version control

PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000

# Login Credentials (server-side only)
KIWAMI_ADMIN_EMAIL=admin@kiwamitech.co.ke
KIWAMI_ADMIN_PASSWORD=Kiwami@2026

# Social Media API Tokens (add real values for production)
FB_TOKEN=your_facebook_page_access_token
IG_TOKEN=your_instagram_api_token
TWITTER_BEARER=your_twitter_bearer_token
LINKEDIN_TOKEN=your_linkedin_api_token
YOUTUBE_API_KEY=your_youtube_data_api_key
TIKTOK_TOKEN=your_tiktok_api_token
